\par }{\rtlch\fcs1 \ab\af0\afs28 \ltrch\fcs0 \b\f0\fs28\dn20\insrsid2172778\charrsid10895192 \hich\af0\dbch\af31505\loch\f0 TIER 3: N-ATLaS AI Model}{\rtlch\fcs1 \af0\afs28 \ltrch\fcs0 \f0\fs28\dn20\insrsid2172778\charrsid10895192 
\par \tab \bullet \hich\af0\dbch\af31505\loch\f0  Llama 3.2 3B - N-ATLaS.Q2_K.gguf (3GB quantized)
